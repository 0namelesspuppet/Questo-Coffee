# ════════════════════════════════════════════════════════════════════
# BULUT (GERCEK FIREBASE) AYARLARI
#
# Yerel emulator yerine gercek Firebase'e baglanmak icin kullanilir.
# Bu dosyayi .env.local olarak KOPYALAMA — yereli bozar. Bulut testinde
# .env.local'i bununla DEGISTIR, yerele donerken eskisini geri koy.
#
# Vercel'e deploy ederken bu degerleri Vercel > Settings > Environment
# Variables'a gir (dosya olarak degil).
# ════════════════════════════════════════════════════════════════════

# ── Firebase Web SDK config (Konsol > Project Settings > Web App) ─────
# "</>" (web) uygulamasi ekleyince ciktiyi buraya yapistir.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check — simdilik bos birak (sonra reCAPTCHA ile aciliriz)
NEXT_PUBLIC_APPCHECK_SITE_KEY=

# Tek-kiraci restoran kimligi (yerelde 'questo' kullaniyordun, ayni kalsin)
NEXT_PUBLIC_RESTORAN_ID=questo

# ── EMULATOR KAPALI — bu satir bulut moduna gecisin anahtari ─────────
NEXT_PUBLIC_USE_EMULATOR=0

# Emulator host degiskenleri BULUNMAMALI (Admin SDK onlari gorurse
# yine emulatore baglanmaya calisir). Bu yuzden bu blokta YOKLAR.

# ── Admin SDK (yalniz sunucu) — service account ──────────────────────
# Konsol > Project Settings > Service accounts > Generate new private key
# Inen JSON dosyasini proje koklerine koy ve yolunu yaz (gitignore'da):
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# VEYA tek satir JSON olarak:
# FIREBASE_SERVICE_ACCOUNT=

# ── Seed / oto-giris hesabi ──────────────────────────────────────────
SEED_SAHIP_EMAIL=sahip@questo.local
KASA_OTOGIRIS_EMAIL=sahip@questo.local
