rules_version = '2';

// Tüm yazma işlemleri Admin SDK üzerinden (Next.js route handler'lardan) yapılır.
// Bu dosya yalnızca OKUMA izinlerini ve emniyet ağı olarak yazma yasaklarını tanımlar.
// App Check zorunluluğu Firebase Console > Firestore üzerinden enforce edilir.

service cloud.firestore {
  match /databases/{database}/documents {

    function kasiyerMi() {
      return request.auth != null
        && request.auth.token.rol == 'kasiyer';
    }

    function sahipMi() {
      return kasiyerMi() && request.auth.token.sahip == true;
    }

    // collectionGroup('siparisler') için zorunlu wildcard kuralı ──────────
    // collectionGroup sorguları tüm yolları tarar; bu kural en üst seviyede
    // olmalı — restoranlar/{id} içine yerleştirilirse Firestore tanımıyor.
    match /{path=**}/siparisler/{siparisId} {
      allow read: if kasiyerMi();
      allow write: if false;
    }

    // ── Idempotency kayıtları — yalnız sunucu (Admin SDK) ──────────────
    // Eşleşmeyen yol zaten reddedilir; sunucu-only niyetini açıkça belgeler.
    // expireAt alanı için Firestore TTL ile 24 saatte otomatik silinir.
    match /idempotency/{anahtar} {
      allow read, write: if false;
    }

    match /restoranlar/{restoranId} {

      // Restoran meta — yalnız personel okur (müşteri tarafı kaldırıldı)
      allow read: if kasiyerMi();
      allow write: if false;

      // ── Menü — yalnız personel okur ─────────────────────────────────
      match /kategoriler/{kategoriId} {
        allow read: if kasiyerMi();
        allow write: if false;
      }

      match /urunler/{urunId} {
        allow read: if kasiyerMi();
        allow write: if false;
      }

      // ── Masalar — yalnız kasiyer listeler ───────────────────────────
      match /masalar/{masaId} {
        allow read: if kasiyerMi();
        allow write: if false;
      }

      // ── Adisyon ve siparişler — yalnız kasiyer canlı dinler ────────
      match /adisyonlar/{adisyonId} {
        allow read: if kasiyerMi();
        allow write: if false;

        match /siparisler/{siparisId} {
          allow read: if kasiyerMi();
          allow write: if false;
        }

        // Ödeme talepleri — yazma Admin SDK üzerinden, okuma kasiyer paneli için
        match /odemeTalepleri/{talepId} {
          allow read: if kasiyerMi();
          allow write: if false;
        }
      }

      // ── Günlük sipariş sayaçları — sadece sunucu ───────────────────
      match /sayaclar/{sayacId} {
        allow read, write: if false;
      }

      // ── Personel kayıtları — yalnız kasiyer okur ──────────────────
      match /kullanicilar/{uid} {
        allow read: if kasiyerMi();
        allow write: if false;
      }

      // ── Denetim kayıtları — yalnız sahip okur ─────────────────────
      match /kullaniciAksiyonlari/{kayitId} {
        allow read: if sahipMi();
        allow write: if false;
      }
    }
  }
}
