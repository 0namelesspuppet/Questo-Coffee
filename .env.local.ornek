# ────────────────────────────────────────────────────────────────────
# YEREL (EMULATOR) AYARLARI
#
# "Questo'yu Baslat.bat" ilk calistiginda .env.local yoksa/bossa bu dosya
# otomatik olarak .env.local'e kopyalanir. Elle de kopyalayabilirsiniz.
#
# Gercek Firebase projesine (production) baglanmak icin .env.example'a bakin.
# ────────────────────────────────────────────────────────────────────

# Emulator modunu ac — client ve admin SDK yerel emulatore baglanir.
NEXT_PUBLIC_USE_EMULATOR=1

# Tek-kiracili restoran kimligi. Uygulama ve seed AYNI degeri kullanmali.
NEXT_PUBLIC_RESTORAN_ID=questo

# Emulator host adresleri.
# 'localhost' Windows'ta IPv6 (::1) cozulebilir, emulator IPv4'te dinler;
# 127.0.0.1 kullanmak en guvenlisidir.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Demo sahip/kasiyer hesabi — seed bu kullaniciyi olusturur (sifre: questo123)
# ve /kasa/giris otomatik olarak bu hesapla giris yapar.
SEED_SAHIP_EMAIL=sahip@questo.local
KASA_OTOGIRIS_EMAIL=sahip@questo.local
